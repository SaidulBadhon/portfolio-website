# Backend API (Bun + Hono server)
# Used by server components/SSR and the dashboard's /api/admin proxy
API_URL=http://localhost:4000

# Used in the browser by the contact form, so it must be publicly reachable
NEXT_PUBLIC_API_URL=http://localhost:4000

# Dashboard auth – set a password to protect /dashboard
DASHBOARD_PASSWORD=your-secret-password

# Shared secret for the API's write/admin endpoints (must match apps/server).
# Also signs dashboard sessions. Generate one with: openssl rand -hex 32
API_SECRET=

# Optional: Google Gemini for "Generate with AI" in project form (get key at https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
